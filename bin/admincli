#!/bin/sh
set -eu

root_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root_dir"

if [ "${IN_DEV_CONTAINER:-}" = "1" ]; then
  exec opam exec -- dune exec apps/admincli/admincli.exe -- "$@"
fi

./scripts/ensure_docker.sh

if docker compose ps --status running --services 2>/dev/null | grep -qx 'app'; then
  exec docker compose exec -T app /app/admincli.exe "$@"
fi

exec docker compose run --rm app /app/admincli.exe "$@"
