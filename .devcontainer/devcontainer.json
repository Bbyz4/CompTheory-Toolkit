{
  "name": "CompTheory Toolkit",
  "dockerComposeFile": [
    "../docker-compose.yml",
    "../docker-compose.dev.yml"
  ],
  "service": "dev",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "runServices": [
    "db",
    "mailpit"
  ],
  "overrideCommand": false,
  "remoteUser": "opam",
  "forwardPorts": [
    5432,
    8025,
    8080,
    8081
  ],
  "postCreateCommand": "git config --global --add safe.directory /workspace && opam exec -- dune build @all",
  "customizations": {
    "vscode": {
      "extensions": [
        "ocamllabs.ocaml-platform",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
