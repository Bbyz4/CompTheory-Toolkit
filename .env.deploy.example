APP_MODE=deployment

POSTGRES_DB=toolkit
POSTGRES_USER=toolkit
POSTGRES_PASSWORD=change-me

APP_HOST=0.0.0.0
APP_PORT=8080
APP_BASE_URL=https://recognita.xyz
PUBLIC_WEB_BASE_URL=https://recognita.xyz

WEB_HOST=0.0.0.0
WEB_PORT=8081
WEB_PUBLIC_PORT=80
WEB_TLS_PUBLIC_PORT=443
API_BASE_URL=http://app:8080
SITE_NAME=Recognita
NGINX_SERVER_NAME=recognita.xyz
NGINX_ENABLE_TLS=auto
NGINX_TLS_CERT_FILE=/etc/nginx/certs/origin.crt
NGINX_TLS_KEY_FILE=/etc/nginx/certs/origin.key
ACCESS_GATE_CODE=pezarski
ACCESS_GATE_COOKIE_SECRET=recognita-gate-cookie-secret-v1

DATABASE_URL=postgresql://toolkit:change-me@db:5432/toolkit

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
VERIFICATION_TOKEN_TTL_SECONDS=86400
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_REQUESTS=20

SMTP_HOST=mailpit
SMTP_PORT=1025
MAILPIT_WEBROOT=/mailpit
MAIL_FROM=no-reply@recognita.xyz
TZ=Europe/Rome
