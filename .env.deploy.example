APP_MODE=deployment
PROJECT_NAME=comp-theory-toolkit
APP_IMAGE=ghcr.io/bbyz4/comp-theory-toolkit:server
NGINX_IMAGE=ghcr.io/bbyz4/comp-theory-toolkit-nginx:server
FAIL2BAN_IMAGE=ghcr.io/bbyz4/comp-theory-toolkit-fail2ban:server

POSTGRES_DB=toolkit
POSTGRES_USER=toolkit
POSTGRES_PASSWORD=change-me
DBRO_USER=recognita_ro
DBRO_PASSWORD=change-me
DBRW_USER=recognita_rw
DBRW_PASSWORD=change-me
RABBITMQ_USER=recognita
RABBITMQ_PASSWORD=change-me

APP_HOST=0.0.0.0
APP_PORT=8080
APP_BASE_URL=https://recognita.xyz
PUBLIC_WEB_BASE_URL=https://recognita.xyz

WEB_HOST=0.0.0.0
WEB_PORT=8081
WEB_PUBLIC_PORT=80
WEB_TLS_PUBLIC_PORT=443
API_BASE_URL=http://app:8080
SITE_NAME=Recognita
NGINX_SERVER_NAME=recognita.xyz
NGINX_ENABLE_TLS=auto
NGINX_TLS_CERT_FILE=/etc/nginx/certs/origin.crt
NGINX_TLS_KEY_FILE=/etc/nginx/certs/origin.key
NGINX_CERTS_DIR=./infra/nginx/certs

DATABASE_URL=postgresql://toolkit:change-me@db:5432/toolkit
DATABASE_URL_RO=postgresql://recognita_ro:change-me@db:5432/toolkit
DATABASE_URL_RW=postgresql://recognita_rw:change-me@db:5432/toolkit

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
VERIFICATION_TOKEN_TTL_SECONDS=86400
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_REQUESTS=20

SMTP_HOST=mailpit
SMTP_PORT=1025
MAILPIT_WEBROOT=/mailpit
MAIL_FROM=no-reply@recognita.xyz
RECOGNITA_ADMIN_USERNAME=recognita_admin
RECOGNITA_ADMIN_PASSWORD=change-me
TZ=Europe/Rome

TRAFFICD_API_BASE_URL=http://app:8080
TRAFFICD_CONTROL_SOCKET=/tmp/trafficd.sock
TRAFFICD_SEED=20260508
TRAFFICD_RATE=3.0
TRAFFICD_REPORT_EVERY=100
TRAFFICD_ADMIN_CLIENT_ID=trafficd-admin
